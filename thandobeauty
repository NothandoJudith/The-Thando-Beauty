body {
    margin: 0;
    font-family: 'Arial', sans-serif;
    background: #fff;
    color: #000;
}

a {
    text-decoration: none;
}

header {
    background: #ff4da6;
    padding: 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: white;
}

header h1 {
    margin: 0;
    font-size: 26px;
}

nav a {
    margin: 0 15px;
    text-decoration: none;
    color: white;
    font-weight: bold;
}

nav a:hover {
    color: #000;
}


.hero {
    height: 90vh;
    background: url("images/salon1.jpg") center/cover no-repeat; 
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    flex-direction: column;
    color: white;
    text-shadow: 2px 2px 5px black;
}

.btn {
    background: black;
    padding: 12px 25px;
    border-radius: 5px;
    color: white;
    text-decoration: none;
    margin-top: 20px;
    font-size: 18px;
}

.btn:hover {
    background: #ff4da6;
}

/* SERVICES PAGE */
.services-container {
    padding: 40px;
}

.service-card {
    background: #ffe6f2;
    border-left: 5px solid #ff4da6;
    padding: 15px;
    margin: 20px 0;
    border-radius: 10px;
}

/* GALLERY PAGE */
.gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    padding: 20px;
}

.gallery img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 10px;
}

/* CONTACT PAGE */
.contact {
    padding: 40px;
    text-align: center;
}

/* BOOKING PAGE */
.booking-container {
    width: 70%;
    margin: auto;
    padding: 40px;
}

.booking-container h2 {
    text-align: center;
    margin-bottom: 20px;
    color: #ff4da6;
}

form {
    display: flex;
    flex-direction: column;
}

form label {
    margin-top: 15px;
    font-weight: bold;
}

form input, select, textarea {
    padding: 10px;
    border: 2px solid #ff4da6;
    border-radius: 5px;
    margin-top: 5px;
}

button {
    margin-top: 20px;
    padding: 12px;
    background: #ff4da6;
    border: none;
    color: white;
    font-size: 18px;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background: black;
}

/* FOOTER */
footer {
    background: black;
    color: white;
    padding: 10px;
    text-align: center;
    margin-top: 30px;
}

